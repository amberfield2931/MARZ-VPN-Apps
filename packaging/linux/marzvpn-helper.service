[Unit]
Description=MARZ VPN helper (kill switch and VPN engine for the MARZ VPN app)
# Early: if the switch was left ON, the block must exist before any network comes up. After the services
# that reload a whole firewall, so they cannot wipe it (the helper's watchdog covers later reloads).
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service nftables.service ufw.service firewalld.service
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=simple
# Done before this unit counts as started, and so before network-pre.target.
ExecStartPre=/usr/lib/marzvpn/marzvpn-helper --arm-from-state
ExecStart=/usr/lib/marzvpn/marzvpn-helper --service
Restart=always
RestartSec=1
# The service stopping does not end the block; only the user's OFF or --recover does. Nothing else.
RuntimeDirectory=marzvpn
RuntimeDirectoryMode=0755
StateDirectory=marzvpn
StateDirectoryMode=0700
StandardOutput=null
StandardError=null
# Only what a TUN VPN needs. resolvectl runs from the engine and talks to systemd-resolved over D-Bus.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
DeviceAllow=/dev/net/tun rw
DevicePolicy=closed
WorkingDirectory=/run/marzvpn

[Install]
WantedBy=sysinit.target
