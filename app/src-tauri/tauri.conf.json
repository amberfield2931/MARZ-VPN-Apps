{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MARZ VPN",
  "version": "0.1.5",
  "identifier": "com.marzvpn.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "title": "MARZ VPN", "width": 440, "height": 780, "minWidth": 360, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
